        },
        {
          "id": "respuesta_elio",
          "op": "dialogue",
          "speaker": "elio",
          "text": {
            "text": "Sí. Desde la cúpula podremos orientarlos."
          }
        },
        {
          "id": "decision",
          "op": "choice",
          "prompt": {
            "text": "¿Qué hace Lara?"
          },
          "options": [
