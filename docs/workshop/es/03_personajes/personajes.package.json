              "id": "acompanar",
              "label": {
                "text": "Acompañar a Elio hasta la cúpula"
              },
              "next": {
                "node": "acompanados"
              }
            },
            {
              "id": "esperar",
              "label": {
                "text": "Esperar junto a la escalera"
              },
              "next": {
                "node": "espera"
              }
            }
          ]
        }
      ]
    },
    {
