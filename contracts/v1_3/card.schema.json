{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gisela.invalid/v1.3/card.schema.json",
  "title": "GISELA card v1.3",
  "oneOf": [
    {
      "$ref": "#/$defs/character"
    },
    {
      "$ref": "#/$defs/location"
    },
    {
      "$ref": "#/$defs/object"
    },
    {
      "$ref": "#/$defs/skill"
    },
    {
      "$ref": "#/$defs/effect"
    }
  ],
  "$defs": {
    "loose_presentation": {
      "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/presentation"
    },
    "character": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "description": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "presentation": {
          "$ref": "#/$defs/loose_presentation"
        },
        "kind": {
          "const": "character"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/property_definition"
          }
        },
        "sofia": {
          "type": "object",
          "required": [
            "strength",
            "openness",
            "fortune",
            "intelligence",
            "awareness"
          ],
          "properties": {
            "strength": {
              "type": "integer"
            },
            "openness": {
              "type": "integer"
            },
            "fortune": {
              "type": "integer"
            },
            "intelligence": {
              "type": "integer"
            },
            "awareness": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 96
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "description": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "presentation": {
          "$ref": "#/$defs/loose_presentation"
        },
        "kind": {
          "const": "location"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/property_definition"
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 96
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "description": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "presentation": {
          "$ref": "#/$defs/loose_presentation"
        },
        "kind": {
          "const": "object"
        },
        "portable": {
          "type": "boolean"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/property_definition"
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 96
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "play"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "description": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "presentation": {
          "$ref": "#/$defs/loose_presentation"
        },
        "kind": {
          "const": "skill"
        },
        "play": {
          "type": "object",
          "required": [
            "effects"
          ],
          "properties": {
            "label": {
              "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
            },
            "requires": {
              "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/condition"
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/operation"
              }
            },
            "outcomes": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/guarded_ops"
              }
            }
          },
          "additionalProperties": false
        },
        "return_policy": {
          "type": "object",
          "required": [
            "default"
          ],
          "properties": {
            "default": {
              "enum": [
                "discard",
                "hand",
                "reserve"
              ]
            },
            "when": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "if",
                  "to"
                ],
                "properties": {
                  "if": {
                    "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/condition"
                  },
                  "to": {
                    "enum": [
                      "discard",
                      "hand",
                      "reserve"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "description": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/localized_text"
        },
        "presentation": {
          "$ref": "#/$defs/loose_presentation"
        },
        "kind": {
          "const": "effect"
        },
        "stacking": {
          "enum": [
            "additive",
            "unique_per_target"
          ]
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stat",
              "amount"
            ],
            "properties": {
              "stat": {
                "enum": [
                  "strength",
                  "openness",
                  "fortune",
                  "intelligence",
                  "awareness"
                ]
              },
              "amount": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "expiration": {
          "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/expiration"
        },
        "on_apply": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/operation"
          }
        },
        "on_expire": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.gisela.invalid/v1.3/common.schema.json#/$defs/operation"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
