{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gisela.invalid/v1.2/initial_state.schema.json",
  "title": "GISELA initial_state v1.2",
  "type": "object",
  "required": ["world_time", "locations", "characters", "objects", "skills", "effects", "capacities"],
  "properties": {
    "world_time": {"type": "string", "format": "date-time"},
    "locations": {"type": "array", "items": {"$ref": "#/$defs/location_instance"}},
    "world_variables": {"type": "object", "additionalProperties": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/json_scalar"}},
    "session_variables": {"type": "object", "additionalProperties": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/json_scalar"}},
    "characters": {"type": "array", "items": {"$ref": "#/$defs/character_instance"}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object_instance"}},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill_instance"}},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect_instance"}},
    "capacities": {"type": "array", "items": {"$ref": "#/$defs/capacity"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "facts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}},
    "current_scene": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
    "player_character": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}
  },
  "additionalProperties": false,
  "$defs": {
    "location_instance": {
      "type": "object",
      "required": ["id", "card"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "card": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "properties": {"type": "object", "additionalProperties": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/json_scalar"}}
      },
      "additionalProperties": false
    },
    "character_instance": {
      "type": "object",
      "required": ["id", "card", "location"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "card": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "location": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "status": {"type": "object", "additionalProperties": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/json_scalar"}},
        "properties": {"type": "object", "additionalProperties": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/json_scalar"}},
        "stats": {"type": "object", "propertyNames": {"enum": ["strength", "openness", "fortune", "intelligence", "awareness"]}, "additionalProperties": {"type": "integer"}},
        "knowledge": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}},
        "beliefs": {"type": "object", "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "additionalProperties": {"type": "boolean"}}
      },
      "additionalProperties": false
    },
    "object_instance": {
      "type": "object",
      "required": ["id", "card"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "card": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "owner": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "location": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "properties": {"type": "object", "additionalProperties": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/json_scalar"}}
      },
      "additionalProperties": false,
      "oneOf": [{"required": ["owner"]}, {"required": ["location"]}]
    },
    "skill_instance": {
      "type": "object",
      "required": ["id", "card", "character", "zone"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "card": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "character": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "zone": {"enum": ["hand", "reserve"]}
      },
      "additionalProperties": false
    },
    "effect_instance": {
      "type": "object",
      "required": ["id", "card", "target", "started_turn", "started_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "card": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "target": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "started_turn": {"type": "integer", "minimum": 0},
        "started_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["from", "to", "key", "value"],
      "properties": {
        "from": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "to": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "value": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/json_scalar"}
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "required": ["character", "hand", "reserve"],
      "properties": {"character": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "hand": {"type": "integer", "minimum": 0}, "reserve": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    }
  }
}
