{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gisela.invalid/v1.2/node.schema.json",
  "title": "GISELA node v1.2",
  "type": "object",
  "required": ["id", "steps"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
    "title": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/localized_text"},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}, "minItems": 1},
    "allow_preparation": {"type": "boolean"}
  },
  "additionalProperties": false,
  "$defs": {
    "step_base": {
      "type": "object",
      "required": ["id", "op"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "op": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}},
      "additionalProperties": false
    },
    "narrate": {
      "type": "object",
      "required": ["id", "op", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "op": {"const": "narrate"},
        "text": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/localized_text"},
        "presentation": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/presentation"}
      },
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "required": ["id", "op", "speaker", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "op": {"const": "dialogue"},
        "speaker": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/entity_ref"},
        "text": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/localized_text"},
        "presentation": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/presentation"}
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": ["id", "op", "options"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "op": {"const": "choice"},
        "prompt": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/localized_text"},
        "options": {"type": "array", "items": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/choice_option"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["id", "op", "test"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "op": {"const": "condition"},
        "test": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/condition"},
        "then": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/destination"},
        "else": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/destination"}
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["id", "op", "effects"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "op": {"const": "effect"},
        "effects": {"type": "array", "items": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/operation"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": ["id", "op", "scene"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "op": {"const": "scene"}, "scene": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}},
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["id", "op", "next"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "op": {"const": "transition"}, "next": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/destination"}},
      "additionalProperties": false
    },
    "ending": {
      "type": "object",
      "required": ["id", "op", "ending"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "op": {"const": "ending"}, "ending": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}},
      "additionalProperties": false
    },
    "prepare_hand": {"type": "object", "required": ["id", "op"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "op": {"const": "prepare_hand"}}, "additionalProperties": false},
    "skill_window": {
      "type": "object",
      "required": ["id", "op"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96}, "op": {"const": "skill_window"}, "max_plays": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "random": {
      "type": "object",
      "required": ["id", "op", "branches"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
        "op": {"const": "random"},
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "weight"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
              "weight": {"type": "integer", "minimum": 1},
              "effects": {"type": "array", "items": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/operation"}},
              "next": {"$ref": "https://schemas.gisela.invalid/v1.2/common.schema.json#/$defs/destination"}
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        {"$ref": "#/$defs/narrate"},
        {"$ref": "#/$defs/dialogue"},
        {"$ref": "#/$defs/choice"},
        {"$ref": "#/$defs/condition"},
        {"$ref": "#/$defs/effect"},
        {"$ref": "#/$defs/scene"},
        {"$ref": "#/$defs/transition"},
        {"$ref": "#/$defs/ending"},
        {"$ref": "#/$defs/prepare_hand"},
        {"$ref": "#/$defs/skill_window"},
        {"$ref": "#/$defs/random"}
      ]
    }
  }
}
