            "kind": "dice_roll",
            "role": "neutral",
            "template": "Dado d{sides}: {result}"
          },
          {
            "kind": "variable_changed",
            "role": "neutral",
            "template": "{variable}: {before} -> {after}"
          },
          {
            "kind": "skill_played",
            "role": "neutral",
            "template": "Termina {card} de {actor}"
          },
