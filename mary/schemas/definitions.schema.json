{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mary.invalid/v1/definitions.schema.json",
  "title": "MARY definitions v1",
  "type": "object",
  "required": ["objectives", "missions"],
  "properties": {
    "objectives": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/objective"}},
    "missions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/mission"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "reference": {"type": "object", "oneOf": [
      {"required": ["literal"], "properties": {"literal": {"$ref": "#/$defs/scalar"}}, "additionalProperties": false},
      {"required": ["value"], "properties": {"value": {"$ref": "#/$defs/id"}}, "additionalProperties": false}
    ]},
    "condition": {"oneOf": [
      {"type": "object", "required": ["constant"], "properties": {"constant": {"type": "boolean"}}, "additionalProperties": false},
      {"type": "object", "required": ["all"], "properties": {"all": {"type": "array", "items": {"$ref": "#/$defs/condition"}}}, "additionalProperties": false},
      {"type": "object", "required": ["any"], "properties": {"any": {"type": "array", "items": {"$ref": "#/$defs/condition"}}}, "additionalProperties": false},
      {"type": "object", "required": ["not"], "properties": {"not": {"$ref": "#/$defs/condition"}}, "additionalProperties": false},
      {"type": "object", "required": ["has_fact"], "properties": {"has_fact": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
      {"type": "object", "required": ["compare"], "properties": {"compare": {"type": "object", "required": ["left", "right", "op"], "properties": {"left": {"$ref": "#/$defs/reference"}, "right": {"$ref": "#/$defs/reference"}, "op": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte"]}}, "additionalProperties": false}}, "additionalProperties": false}
    ]},
    "criterion": {"oneOf": [
      {"type": "object", "required": ["kind", "when"], "properties": {"kind": {"const": "condition"}, "when": {"$ref": "#/$defs/condition"}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "facts", "minimum"], "properties": {"kind": {"const": "distinct"}, "facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "minimum": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "weights", "minimum"], "properties": {"kind": {"const": "weighted"}, "weights": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"type": "integer", "minimum": 1}}, "minimum": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
    ]},
    "yield": {"type": "object", "required": ["fact"], "properties": {"fact": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "objective": {"type": "object", "required": ["id", "criterion", "mode"], "properties": {"id": {"$ref": "#/$defs/id"}, "criterion": {"$ref": "#/$defs/criterion"}, "mode": {"enum": ["milestone", "current"]}, "scope": {"enum": ["session", "campaign"]}, "visibility": {"enum": ["public", "hidden"]}, "title": {"type": "string", "minLength": 1}, "yield": {"$ref": "#/$defs/yield"}}, "additionalProperties": false},
    "mission": {"type": "object", "required": ["id", "title", "objectives", "completion"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "completion": {"enum": ["all", "any"]}, "visibility": {"enum": ["public", "hidden"]}, "scope": {"enum": ["session", "campaign"]}, "activate_when": {"$ref": "#/$defs/condition"}, "fail_when": {"$ref": "#/$defs/condition"}, "yield": {"$ref": "#/$defs/yield"}}, "additionalProperties": false}
  }
}
